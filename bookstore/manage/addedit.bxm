<bx:param name = "book" default=""/>
<bx:set bookstoreFunctions = createObject("bookstore.common.books")>



<bx:output> 
<bx:dump var="#form#"/>

  <bx:if form.keyExists("isbn13")>
        <bx:if form.keyExists("uploadimage") && form.uploadimage.len()>
        <bx:set fileinfo = bookstoreFunctions.uploadFile("uploadimage")/>
        <bx:dump var="#fileinfo#"/>
        <bx:set form.image = fileInfo.serverFileName />
        </bx:if>
        <!-- Handle genre assignment -->
        <bx:script>
          if(form.keyExists("genre")){
              // First, clear existing genres for the book
              bookstoreFunctions.clearAllBookGenres(form.isbn13);

              // Convert the list of selected genres into an array and loop through each one
              form.genre.listToArray().each(function(item){
                  // Save each genre to the book
                  bookstoreFunctions.saveGenreToBook(item, form.isbn13);
              });
          }
        </bx:script>
    <bx:set bookstoreFunctions.saveBooks(form.title, form.isbn13, form.isbn, form.year, form.weight, form.pages, form.image, form.publisherId, form.description) />
</bx:if>
<bx:set allBooks = bookstorefunctions.allBooks() >
<div class="row">
    <div class="col-3">
        Book list <ul class="nav flex-column"> 
          <li class="nav-item"> 
            <a class="nav-link" href="#cgi.SCRIPT_NAME#?t=addedit&book=new">
              New Book
            </a>
          </li>
          <bx:output query="allBooks">
          <li class="nav-item"> 
            <a class="nav-link" href="#cgi.SCRIPT_NAME#?t=addedit&book=#isbn13#">
              #title#
            </a>
          </li>
        </bx:output>
        </ul>
    </div>
    <div class="col-9">
     Book list
        <bx:if book.len() gt 0>
        <bx:set bookinfo = bookstoreFunctions.searchBooks(book)>
        <bx:dump var="#bookinfo#">   
        <bx:set allPublishers = bookstoreFunctions.allPublishers()>
        <bx:set allGenres = bookstoreFunctions.allGenres() />
        <bx:set bookGenres = bookstoreFunctions.allGenresForBook(book)/>
        <form action="#cgi.script_name#?t=addEdit&book=#book#" method="POST" enctype="multipart/form-data" >  
          <input type="hidden" name="image" value="#trim(bookinfo.image[1])#">
          <label for="uploadImage">Upload Cover</label>
          <div class="input-group mb-3">    
              <input type="file" id="uploadImage" name="uploadimage" class="form-control" />    
          </div>
          <div class="form-floating mb-3">
                  <input 
                    type="text" 
                    class="form-control" 
                    id="floatingInput" 
                    placeholder="Title" 
                    name="title" 
                    value="">
                  <label for="floatingInput">Title</label>
              </div>
              <div class="form-floating mb-3">
                <input 
                  type="text" 
                  class="form-control" 
                  id="floatingInput" 
                  placeholder="ISBN13" 
                  name="ISBN13" 
                  value="">
                <label for="floatingInput">ISBN13</label>
            </div>
            <div class="form-floating mb-3">
                <input 
                  type="text" 
                  class="form-control" 
                  id="floatingInput" 
                  placeholder="ISBN" 
                  name="ISBN" 
                  value="">
                <label for="floatingInput">ISBN</label>
            </div>
            <div class="form-floating mb-3">
                <input 
                  type="text" 
                  class="form-control" 
                  id="floatingInput" 
                  placeholder="year" 
                  name="year" 
                  value="">
                <label for="floatingInput">year</label>
            </div>
            <div class="form-floating mb-3">
                <input 
                  type="text" 
                  class="form-control" 
                  id="floatingInput" 
                  placeholder="weight" 
                  name="weight" 
                  value="">
                <label for="floatingInput">weight</label>
            </div>
            <div class="form-floating mb-3">
                <input 
                  type="text" 
                  class="form-control" 
                  id="floatingInput" 
                  placeholder="pages" 
                  name="pages" 
                  value="">
                <label for="floatingInput">pages</label>
            </div>
            <div class="form-floating mb-3">
              <textarea id="description" name="description" class="form-control">
                  #bookinfo.description#
              </textarea>
          </div>

          <!--- Publisher --->
          <div class="form-floating mb-3">
            <select class="form-select" id="publisher" name="publisherId" aria-label="Publisher Select Control">
                <option></option> <!--- Empty option for clarity --->
                <bx:loop query="allPublishers">
                <option value="#id#" #id == bookinfo.publisherid ? "selected" : ""#** >#name#</option>
                </bx:loop>
            </select>
            <label for="publisher">Publisher</label>
        </div>

      <label>Genres</label>
        <div class="form-floating mb-3">
          <div>
              <!-- Loop through all genres and create checkboxes -->
              <bx:loop query="allGenres">
                  <input id="genre#id#" type="checkbox" name="genre" value="#id#" /> #name#<br/>
              </bx:loop>
          </div>

          <bx:loop query="bookGenres">
            <script>
                document.getElementById('genre#genreid#').checked = true;
            </script>
          </bx:loop>
      </div>             
            <button type="submit" class="btn btn-primary w-100" style="width:100%">Save</button>
            </form>
          </bx:if>
        </bx:output>

    </div>
</div>

<script type="text/javascript">
  const { 
    ClassicEditor,
    Essentials,
    Bold,
    Italic,
    Font,
    Paragraph
  } = CKEDITOR;

  ClassicEditor
    .create( document.querySelector( '#description' ), {
        licenseKey: 'eyJhbGciOiJFUzI1NiJ9..WVB5rEYWNC-qmrhTk8hF_tMBbM_gujAQ6gDXjCh-ytRy5HJzJvgLk1fh0insxH_lZzg920fQmKVkj0-dMB4Ltg',
        plugins: [ Essentials, Bold, Italic, Font, Paragraph ],
        toolbar: [
            'undo', 'redo', '|', 'bold', 'italic', '|',
            'fontSize', 'fontFamily', 'fontColor', 'fontBackgroundColor'
        ]
    })
    .then( /* ... */ )
    .catch( /* ... */ );
</script>